# Source PostgreSQL (required for source-preflight and setup-source)
PG_DSN=

# ClickHouse query endpoint (required for preflight and run)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Destination tables created by Sync to ClickHouse / ClickPipes
CLICKHOUSE_SMALL_TABLE=cdc_lab_cdc_probe_small
CLICKHOUSE_LARGE_TABLE=cdc_lab_cdc_probe_large

# Optional when more than one logical slot exists
CLICKPIPE_SLOT=

# Optional ClickHouse Cloud Prometheus collection. Keep the secret only in .env.
CLICKHOUSE_CLOUD_ORGANIZATION_ID=
CLICKHOUSE_CLOUD_API_KEY_ID=
CLICKHOUSE_CLOUD_API_KEY_SECRET=
# Optional when the organization exposes more than one ClickPipe
CLICKPIPE_ID=
CLICKPIPE_METRICS_POLL_SECONDS=15

# Sanitized experiment descriptors (never put secrets here)
PG_CDC_LAB_CONFIGURATION=default_60s
PG_CDC_LAB_SYNC_INTERVAL_SECONDS=60
PG_CDC_LAB_PULL_BATCH_SIZE=100000
PG_CDC_LAB_PG_SERVICE_SIZE=unknown
PG_CDC_LAB_CH_SERVICE_SIZE=unknown
PG_CDC_LAB_PG_REGION=unknown
PG_CDC_LAB_CH_REGION=unknown
PG_CDC_LAB_HA_TOPOLOGY=unknown
